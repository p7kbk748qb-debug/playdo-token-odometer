<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PlayDo's Token Odometer" Width="1040" Height="800" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="{DynamicResource ButtonRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Pressed}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,8"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="40"/><Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="DropBorder" CornerRadius="7" Background="{DynamicResource Control}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="10" Height="5" HorizontalAlignment="Right" Margin="0,0,13,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="DropBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,8,34,8" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border x:Name="PopupBorder" Width="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="3" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    <Border x:Name="FocusBorder" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ThemeCardStyle" TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CardFrame" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardFrame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardFrame" Property="BorderThickness" Value="3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuFrame" Padding="{TemplateBinding Padding}" Background="{DynamicResource Surface}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuFrame" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuFrame" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource DetailBrush}">
  <ScrollViewer x:Name="FullView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="28,24,28,18">
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="HeaderBrand" Orientation="Horizontal"><Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Accent}" Margin="0,0,14,0"><Viewbox Margin="10"><Path Fill="{DynamicResource OnAccent}" Data="M 1,2 L 9,2 C 17,2 17,14 9,14 L 6,14 L 6,21 L 1,21 Z M 6,6 L 6,10 L 9,10 C 12,10 12,6 9,6 Z"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="PlayDo's" FontSize="13" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text="Token Odometer" FontSize="25" FontWeight="SemiBold" Margin="0,-2,0,0"/></StackPanel></StackPanel>
     <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="MiniButton" Content="Mini" Margin="0,0,8,0"/><Button x:Name="CompactButton" Content="Compact" Margin="0,0,8,0"/><Button x:Name="SettingsButton" Content="Appearance &amp; settings"/></StackPanel>
    </Grid>
    <Border x:Name="SettingsPanel" Visibility="Collapsed" CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="20" Margin="0,0,0,20"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Appearance &amp; settings" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Choose a theme, adjust fonts or set up your small windows." Style="{StaticResource Label}" Margin="0,5,0,0" TextWrapping="Wrap"/><Button x:Name="SmallSettingsButton" Content="Mini &amp; Compact settings" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel><Button x:Name="CloseSettingsButton" Content="Done" Grid.Column="1" VerticalAlignment="Top" ToolTip="Close appearance · Escape"/></Grid>
     <UniformGrid x:Name="ThemeGallery" Columns="3" Margin="-4,14,-4,14"/>
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Fine tune your style" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Fonts are local to your PC. Presets restore their own font pair and counter." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button x:Name="RestorePresetButton" Grid.Column="1" Content="Restore preset" ToolTip="Reset fonts and counter to this theme's styling" VerticalAlignment="Top"/></Grid>
     <UniformGrid x:Name="AppearanceChoices" Columns="3" Margin="0,0,-12,0">
      <StackPanel Margin="0,0,12,12"><TextBlock Text="Preset" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="ThemeChoice" AutomationProperties.Name="Appearance preset"/></StackPanel>
      <StackPanel Margin="0,0,12,12"><TextBlock Text="Text font" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="FontChoice" AutomationProperties.Name="Application font"/></StackPanel>
      <StackPanel Margin="0,0,12,12"><TextBlock Text="Number font" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="NumberFontChoice" AutomationProperties.Name="Number font"/></StackPanel>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Counter treatment" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="CounterChoice" AutomationProperties.Name="Counter style"/></StackPanel>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Window" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox x:Name="ViewChoice" AutomationProperties.Name="Window size"/></StackPanel>
     </UniformGrid>
     <TextBlock x:Name="AppearanceNote" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" Text="Instrument · Segoe UI · Mechanical"/>
     <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="TopmostCheck" Content="Always on top" Margin="0,8,26,8"/><CheckBox x:Name="MotionCheck" Content="Reduce motion" Margin="0,8,26,8"/><CheckBox x:Name="StartupCheck" Content="Start with Windows"/></WrapPanel>
     <WrapPanel Margin="0,12,0,10"><Button x:Name="PauseButton" Content="Pause tracking" Margin="0,0,8,0"/><Button x:Name="RescanButton" Content="Check for new files" Margin="0,0,8,0"/><Button x:Name="FolderButton" Content="Open app folder" Margin="0,0,8,0"/><Button x:Name="ExitButton" Content="Exit app"/></WrapPanel>
     <TextBlock x:Name="SettingsNote" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Text="Closing the window keeps tracking in the tray. Startup is optional. Mini and Compact have their own widget settings."/>
     <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Stroke}" Margin="0,10,0,0" Padding="0,12,0,0"><StackPanel><TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold"/><TextBlock Text="Ctrl+1 / 2 / 3  Today / 7 days / Recorded    ·    Ctrl+Shift+C  Copy total&#10;Ctrl+E  Export CSV    ·    Ctrl+,  Style studio    ·    Ctrl+M  Compact    ·    Ctrl+Shift+M  Mini" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,10"/><TextBlock x:Name="AboutText" FontSize="12" Foreground="{DynamicResource Muted}" Text="PlayDo's Token Odometer · local, private and portable"/></StackPanel></Border>
    </StackPanel></Border>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource Signal}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Starting collector" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="TodayButton" Content="Today" Padding="13,6" Margin="0,0,6,0"/><Button x:Name="WeekButton" Content="7 days" Padding="13,6" Margin="0,0,6,0"/><Button x:Name="AllButton" Content="Recorded" Padding="13,6"/></StackPanel>
    </Grid>
    <Border x:Name="CounterHousing" Background="{DynamicResource SurfaceMaterial}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}" Padding="24,22"><Grid><Border Background="{DynamicResource DetailBrush}" IsHitTestVisible="False"/><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ScopeLabel" Text="Today's reported tokens" FontSize="17" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Codex · local records" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid>
     <Viewbox Height="86" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,18,0,8"><StackPanel x:Name="Digits" Orientation="Horizontal" AutomationProperties.Name="Token count"/></Viewbox>
     <TextBlock x:Name="TotalAccessible" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,18" Text="Waiting for reported usage"/>
     <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,18"/>
     <UniformGrid Columns="3"><StackPanel><TextBlock Text="Input" Style="{StaticResource Label}"/><TextBlock x:Name="InputText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="Output" Style="{StaticResource Label}"/><TextBlock x:Name="OutputText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="Cached input" Style="{StaticResource Label}"/><TextBlock x:Name="CacheText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Already included in input" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel></UniformGrid>
     <WrapPanel Margin="0,18,0,0"><Button x:Name="CopyButton" Content="Copy total" Padding="13,6" MinHeight="34" Margin="0,0,8,0" ToolTip="Copy this scope's token count · Ctrl+Shift+C"/><Button x:Name="ExportButton" Content="Export CSV" Padding="13,6" MinHeight="34" Margin="0,0,12,0" ToolTip="Export aggregate model usage · Ctrl+E"/><TextBlock x:Name="ActionFeedback" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/></WrapPanel>
    </StackPanel></Grid></Border>
    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}" Padding="20,16" Margin="0,16,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0"><TextBlock x:Name="QuotaTitle" Text="Account allowance" Style="{StaticResource Label}"/><TextBlock x:Name="QuotaValue" Text="Not yet reported" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource Signal}"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0"><ProgressBar x:Name="QuotaBar" Height="5" Foreground="{DynamicResource Signal}" Background="{DynamicResource Stroke}" BorderThickness="0" Value="0"/><TextBlock x:Name="QuotaReset" Text="Waiting for a Codex quota snapshot" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="QuotaAge" Text="No snapshot" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/><TextBlock x:Name="QuotaExtra" Text="Reported separately from tokens" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel>
    </Grid></Border>
    <Grid x:Name="BreakdownGrid" Margin="0,0,0,24">
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}" Padding="20"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Models in use" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ModelScope" Grid.Column="1" Text="Today" Style="{StaticResource Label}" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="Approximate tokens · local model metadata" Style="{StaticResource Label}" Margin="0,5,0,14"/>
      <ScrollViewer MaxHeight="322" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ModelList"/></ScrollViewer>
      <Button x:Name="MoreModelsButton" Content="Show all models" Visibility="Collapsed" Padding="12,6" MinHeight="34" Margin="0,8,0,0" HorizontalAlignment="Left"/>
      <TextBlock x:Name="ModelNote" Text="Unknown keeps usage whose model was not reported." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel></Border>
    </Grid>
    <Grid x:Name="DetailsGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Your last 7 days" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Reported tokens by local date" Style="{StaticResource Label}" Margin="0,5,0,14"/><Grid x:Name="Chart" Height="132"/><TextBlock x:Name="ChartSummary" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Latest sessions" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Local session IDs · recorded usage" Style="{StaticResource Label}" Margin="0,5,0,10"/><StackPanel x:Name="SessionList"/></StackPanel>
    </Grid>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,12,0,0"><StackPanel><TextBlock x:Name="CoverageText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Updates when Codex reports usage. Local observations may not cover every device or archived chat." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="CompactView" Visibility="Collapsed" Padding="20,16" Background="{DynamicResource SurfaceMaterial}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource DetailBrush}" Grid.RowSpan="3" IsHitTestVisible="False"/>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CompactStyleButton" Content="Settings" Padding="8,5" MinHeight="32" Margin="0,0,5,0" ToolTip="Choose what Mini and Compact show"/><Button x:Name="ExpandButton" Content="Expand" Padding="8,5" MinHeight="32" Margin="0,0,5,0"/><Button x:Name="CompactMenuButton" Content="⋯" Padding="8,4" MinHeight="32" AutomationProperties.Name="Scope and actions" ToolTip="Scope, copy total and export"/></StackPanel><StackPanel><TextBlock Text="PlayDo's" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock x:Name="CompactScope" Text="Token Odometer · Today" FontSize="12" FontWeight="SemiBold"/></StackPanel></DockPanel>
   <Viewbox x:Name="CompactCounterBox" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,14"><StackPanel x:Name="CompactDigits" Orientation="Horizontal"/></Viewbox>
   <StackPanel Grid.Row="2" x:Name="SmallWidgets">
    <TextBlock x:Name="SmallBreakdown" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="SmallModel" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
    <StackPanel x:Name="SmallPrimary" Margin="0,0,0,10"><TextBlock x:Name="SmallPrimaryText" FontSize="12" Margin="0,0,0,5"/><ProgressBar x:Name="SmallPrimaryBar" Height="5" Minimum="0" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Stroke}" BorderThickness="0"/><TextBlock x:Name="SmallPrimaryReset" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
    <StackPanel x:Name="SmallWeekly" Margin="0,0,0,10"><TextBlock x:Name="SmallWeeklyText" FontSize="12" Margin="0,0,0,5"/><ProgressBar x:Name="SmallWeeklyBar" Height="5" Minimum="0" Maximum="100" Foreground="{DynamicResource Signal}" Background="{DynamicResource Stroke}" BorderThickness="0"/><TextBlock x:Name="SmallWeeklyReset" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
    <TextBlock x:Name="CompactStatus" Text="Watching local Codex usage" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Grid></Border>
 </Grid>
</Window>
