<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PlayDo.Desktop.App" RequestedThemeVariant="Dark">
 <Application.Styles><FluentTheme/>
  <Style Selector="Window"><Setter Property="FontFamily" Value="fonts:Inter#Inter"/><Setter Property="FontSize" Value="13"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style Selector="Button.rail"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,12"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
 </Application.Styles>
</Application>
