<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PlayDo.Desktop.MainWindow"
 Title="PlayDo’s Token Odometer" Width="1080" Height="780" MinWidth="760" MinHeight="540" Background="{DynamicResource Canvas}" WindowStartupLocation="CenterScreen"
 TransparencyLevelHint="Transparent" Icon="/Assets/app.ico">
 <Grid x:Name="Root">
  <Grid x:Name="Dashboard" ColumnDefinitions="184,*">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0" Padding="16,24"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,28"><Image Source="/Assets/app-icon.png" Width="32" Height="32" HorizontalAlignment="Left" Margin="10,0,0,12"/><TextBlock Text="Token" FontSize="20" FontWeight="SemiBold" Margin="10,0"/><TextBlock Text="Odometer" FontSize="20" FontWeight="SemiBold" Margin="10,0"/><TextBlock Text="by PlayDo" Classes="muted" FontSize="11" Margin="10,6"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="10"><TextBlock Text="On your desktop" Classes="muted" FontSize="11" Margin="8,0"/><UniformGrid Columns="2"><Button x:Name="QuickMini" Content="Mini" Margin="0,0,4,0" Padding="6,8"/><Button x:Name="QuickTiny" Content="Tiny" Margin="4,0,0,0" Padding="6,8"/></UniformGrid><TextBlock Text="Local records.&#10;Private by default." Classes="muted" FontSize="11" LineHeight="18" Margin="8,4"/></StackPanel>
    <StackPanel><Button x:Name="OverviewNav" Classes="rail" ><StackPanel Orientation="Horizontal" Spacing="12"><Path Data="M1,1 H7 V7 H1 Z M11,1 H17 V7 H11 Z M1,11 H7 V17 H1 Z M11,11 H17 V17 H11 Z" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/><TextBlock Text="Overview"/></StackPanel></Button><Button x:Name="ProvidersNav" Classes="rail" ><StackPanel Orientation="Horizontal" Spacing="12"><Path Data="M6,1 V6 M12,1 V6 M3,6 H15 V9 A6,6 0 0 1 9,15 V18 M9,15 A6,6 0 0 1 3,9" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/><TextBlock Text="Providers"/></StackPanel></Button><Button x:Name="AppearanceNav" Classes="rail" ><StackPanel Orientation="Horizontal" Spacing="12"><Path Data="M3,2 H15 V7 H3 Z M15,4 H18 V10 H9 V16 M7,16 H11 V19 H7 Z" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/><TextBlock Text="Appearance"/></StackPanel></Button><Button x:Name="SettingsNav" Classes="rail" ><StackPanel Orientation="Horizontal" Spacing="12"><Path Data="M1,4 H17 M1,10 H17 M1,16 H17 M5,1 V7 M13,7 V13 M7,13 V19" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/><TextBlock Text="Settings"/></StackPanel></Button></StackPanel>
   </DockPanel></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Column="1" Padding="30,28" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="PageContent" Spacing="24">
     <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock x:Name="PageTitle" Text="Usage overview" Classes="heading"/><TextBlock x:Name="PageSubtitle" Text="Your selected tools, in one counter." Classes="muted" Margin="0,6,0,0"/></StackPanel><ComboBox x:Name="LayoutChoice" Grid.Column="1" Width="132" VerticalAlignment="Center" AutomationProperties.Name="Window layout"/></Grid>
     <StackPanel x:Name="OverviewPage" Spacing="18">
      <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource Signal}"/><TextBlock x:Name="Status" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="290"/></StackPanel><ComboBox x:Name="ScopeChoice" Grid.Column="1" Width="138" AutomationProperties.Name="Token period"/></Grid>
      <StackPanel Spacing="10">
       <TextBlock x:Name="ScopeLabel" Text="Today’s tokens" Classes="muted" FontSize="13"/>
       <Viewbox Height="64" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="Total" Text="—" FontSize="68" FontWeight="Medium" Foreground="{DynamicResource Accent}"/></Viewbox>
       <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SourceSummary" Classes="muted" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CopyButton" Content="Copy total"/><Button x:Name="ExportButton" Content="Export CSV"/></StackPanel></Grid>
      </StackPanel>
      <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1" Padding="0,12">
       <Grid ColumnDefinitions="*,*,*"><StackPanel Spacing="5"><TextBlock Text="Input" Classes="muted" FontSize="12"/><TextBlock x:Name="InputValue" FontSize="24"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Output" Classes="muted" FontSize="12"/><TextBlock x:Name="OutputValue" FontSize="24"/></StackPanel><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Cached input" Classes="muted" FontSize="12"/><TextBlock x:Name="CacheValue" FontSize="24"/><TextBlock x:Name="CacheShare" Classes="muted" FontSize="11"/></StackPanel></Grid>
      </Border>
      <UniformGrid x:Name="ProviderSummary" Columns="4"/>
      <Grid x:Name="AnalyticsGrid" ColumnDefinitions="1.4*,20,*" RowDefinitions="Auto,Auto">
       <Border x:Name="ChartPanel" Classes="panel" Padding="20"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Last seven days" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ChartTotal" Grid.Column="1" Classes="muted" VerticalAlignment="Center" FontSize="11"/></Grid><Grid x:Name="DayChart" Height="170"/><TextBlock x:Name="ChartNote" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
       <Border x:Name="AllowancePanel" Grid.Column="2" Classes="panel" Padding="20"><StackPanel Spacing="14"><TextBlock Text="Codex allowance" FontSize="16" FontWeight="SemiBold"/><StackPanel x:Name="AllowanceRows" Spacing="16"/><TextBlock x:Name="AllowanceText" Classes="muted" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Account snapshot · separate from tokens" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid>
      <StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Model breakdown" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ModelCount" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center"/></Grid><StackPanel x:Name="ModelRows" Spacing="14"/><Button x:Name="MoreModels" Content="Show all models" HorizontalAlignment="Left"/></StackPanel>
      <TextBlock x:Name="LastReport" Classes="muted" FontSize="11"/>
      <TextBlock Text="Counts follow complete local reports. Missing logs and other devices can limit coverage. Subscription credits are not inferred." Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
     <StackPanel x:Name="ProvidersPage" IsVisible="False" Spacing="18">
      <TextBlock Text="Select the tools you want to count. Existing local reports are detected automatically; you can also choose a custom folder." Classes="muted" TextWrapping="Wrap"/>
      <StackPanel x:Name="ProviderRows" Spacing="12"/>
      <Border Classes="panel"><StackPanel Spacing="8"><TextBlock Text="Other AI apps" FontWeight="SemiBold"/><TextBlock Text="Web chats and apps that don’t expose local token reports cannot be counted reliably. This release does not read browser sessions, collect account keys, or estimate usage from message length." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AppearancePage" IsVisible="False" Spacing="20">
      <Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="8"><TextBlock Text="Interface font" FontWeight="Medium"/><ComboBox x:Name="InterfaceFont" HorizontalAlignment="Stretch" AutomationProperties.Name="Interface font"/></StackPanel><StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="Number font" FontWeight="Medium"/><ComboBox x:Name="CounterFont" HorizontalAlignment="Stretch" AutomationProperties.Name="Number font"/></StackPanel></Grid>
      <Border Classes="panel" Padding="16"><StackPanel Spacing="8"><Viewbox Height="46" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="NumberPreview" Text="396,659,182" FontSize="48" Foreground="{DynamicResource Accent}"/></Viewbox><TextBlock x:Name="FontNote" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
      <StackPanel Spacing="6"><TextBlock Text="Choose a starting point" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Themes apply a full palette and font pair. Fine-tune either font above." Classes="muted" TextWrapping="Wrap"/></StackPanel>
      <UniformGrid x:Name="ThemeGallery" Columns="3"/>
      <CheckBox x:Name="AnimateCheck" Content="Animate token increases"/><CheckBox x:Name="EffectsCheck" Content="Interface transitions and chart effects"/><CheckBox x:Name="MotionCheck" Content="Reduce motion"/>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" IsVisible="False" Spacing="18">
      <TextBlock Text="Desktop widget" FontSize="17" FontWeight="SemiBold"/>
      <CheckBox x:Name="TopmostCheck" Content="Keep the widget above other windows"/>
      <CheckBox x:Name="PauseCheck" Content="Pause collection (resume catches up)"/>
      <CheckBox x:Name="TransparentCheck" Content="Use a transparent widget background"/>
      <CheckBox x:Name="QuotaCheck" Content="Show Codex allowance in Mini and Compact"/>
      <StackPanel Spacing="10"><TextBlock Text="Mini &amp; Compact content" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="WidgetOptionsChoice" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Widget to configure"/><StackPanel x:Name="WidgetOptionRows" Spacing="8"/></StackPanel>
      <StackPanel Spacing="8"><TextBlock Text="Screen corner"/><ComboBox x:Name="CornerChoice" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Screen corner"/></StackPanel>
      <Border Classes="panel"><StackPanel Spacing="8"><TextBlock Text="Local data" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DataPath" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="The data folder holds aggregate counts, settings, and hashed replay metadata. It does not store your conversation bodies." Classes="muted" TextWrapping="Wrap"/><Button x:Name="DataButton" Content="Open data folder" HorizontalAlignment="Left"/></StackPanel></Border>
      <TextBlock Text="Close the window to keep tracking in the menu bar or system tray. Use Exit to stop the collector. Drag widgets by the number or background; right-click to change views." Classes="muted" TextWrapping="Wrap"/>
      <Button x:Name="ExitButton" Content="Exit application" HorizontalAlignment="Left"/>
     </StackPanel>
     <TextBlock x:Name="Feedback" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border x:Name="Widget" IsVisible="False" CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="14,10">
   <Grid RowDefinitions="Auto,*,Auto">
    <Grid x:Name="WidgetHeader" ColumnDefinitions="*,Auto"><TextBlock x:Name="WidgetScope" Classes="muted" VerticalAlignment="Center" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button x:Name="WidgetSettings" Content="Settings" Padding="8,3" MinHeight="28"/><Button x:Name="WidgetExpand" Content="Expand" Padding="8,3" MinHeight="28"/><Button x:Name="WidgetHide" Content="Hide" Padding="8,3" MinHeight="28"/></StackPanel></Grid>
    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,5,0,0"><TextBlock x:Name="WidgetNumber" Text="—" FontSize="56" Foreground="{DynamicResource Accent}"/></Viewbox>
    <StackPanel x:Name="WidgetDetails" Grid.Row="2" Spacing="7">
     <TextBlock x:Name="WidgetBreakdown" Classes="muted" FontSize="12"/>
     <TextBlock x:Name="WidgetModel" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
     <StackPanel x:Name="WidgetPrimary" Spacing="4"><TextBlock x:Name="WidgetPrimaryText" Classes="muted" FontSize="11"/><ProgressBar x:Name="WidgetPrimaryBar" Height="4" Maximum="100" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="WidgetPrimaryReset" Classes="muted" FontSize="10"/></StackPanel>
     <StackPanel x:Name="WidgetWeekly" Spacing="4"><TextBlock x:Name="WidgetWeeklyText" Classes="muted" FontSize="11"/><ProgressBar x:Name="WidgetWeeklyBar" Height="4" Maximum="100" Foreground="{DynamicResource Signal}"/><TextBlock x:Name="WidgetWeeklyReset" Classes="muted" FontSize="10"/></StackPanel>
     <TextBlock x:Name="WidgetActivity" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel x:Name="TinyActions" IsVisible="False" Grid.RowSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="TinyHide" AutomationProperties.Name="Hide Tiny" ToolTip.Tip="Hide to tray" MinHeight="18" Height="18" Width="18" Padding="0"><Path Data="M 1,5 H 9" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" Width="10" Height="10"/></Button><Button x:Name="TinyExpand" AutomationProperties.Name="Expand Tiny" ToolTip.Tip="Open dashboard" MinHeight="18" Height="18" Width="18" Padding="0"><Path Data="M 1,4 V 1 H 4 M 6,1 H 9 V 4 M 9,6 V 9 H 6 M 4,9 H 1 V 6" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" Width="10" Height="10"/></Button></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
